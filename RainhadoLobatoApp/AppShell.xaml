<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ScheduleListUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ScheduleListUI.Views"
    Shell.BackgroundColor="#2196f3"
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarBackgroundColor="#2196f3"
    Shell.TabBarTitleColor="White"
    Shell.TabBarUnselectedColor="white">



    <TabBar>


        <Tab Title="Home" Icon="home">
            <ShellContent ContentTemplate="{DataTemplate local:HomePage}" />
        </Tab>

        <Tab Title="Agenda" Icon="agenda">
            <ShellContent ContentTemplate="{DataTemplate local:ScheduleListView}" />
        </Tab>

        <Tab Title="Perfil" Icon="perfil">
            <ShellContent ContentTemplate="{DataTemplate local:Menu}" />
        </Tab>


        <Tab Title="Recados" Icon="notificacoes">
            <ShellContent ContentTemplate="{DataTemplate local:Recados}" />
        </Tab>
        <Tab Title="Eventos" Icon="camera">
            <ShellContent ContentTemplate="{DataTemplate local:MuraldeEventosPage}" />
        </Tab>
       
    </TabBar>


</Shell>
