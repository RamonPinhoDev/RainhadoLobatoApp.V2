<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ScheduleListUI.Views.ComentarioPage"
                   xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"

            >
    
  
    <Grid
     Margin="50,150,50,150"
 RowDefinitions="Auto, Auto,*"
 RowSpacing="10"
          WidthRequest="350"
        HeightRequest="500"
        
        >
        <Frame
     Grid.Row="0"
     Padding="15"
     BackgroundColor="White">
            <VerticalStackLayout>
                <Entry x:Name="EntComent" Placeholder="Digite seu comentário" ReturnType="Next"/>

               
            </VerticalStackLayout>
        </Frame>
        <Button
            x:Name="BtnComentar"
            Grid.Row="1"
            BackgroundColor="#2196f3"
            Clicked="BtnComentar_Clicked"
            FontSize="14"
            Text="Comentar"
            WidthRequest="95"
            HorizontalOptions="End"
            
            
            />
        <ScrollView Grid.Row="2">

            <ListView
         x:Name="ProfSingle"
         HasUnevenRows="True"
         ItemsSource="{Binding Comentarios}"
         SelectionMode="Single">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Grid Padding="10" ColumnSpacing="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />


                                </Grid.ColumnDefinitions>

                                <Image
                             Grid.RowSpan="2"
                             Grid.Column="0"
                             Aspect="AspectFill"
                             HeightRequest="60"
                             Source="{Binding ImgUrl}"
                             VerticalOptions="Start"
                             WidthRequest="60" />

                                <Label
                             Grid.Row="0"
                             Grid.Column="1"
                             FontAttributes="Bold"
                             FontSize="18"
                             Text="{Binding UsuarioNome}" />

                                <Label
                             Grid.Row="1"
                             Grid.Column="1"
                             FontAttributes="Italic"
                             LineBreakMode="WordWrap"
                             Text="{Binding Mensagem}" />


                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>





        </ScrollView>
    </Grid>
</toolkit:Popup>