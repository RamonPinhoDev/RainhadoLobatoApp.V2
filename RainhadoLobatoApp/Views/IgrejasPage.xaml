<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ScheduleListUI.Views.IgrejasPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Igrejas">
    <VerticalStackLayout>
        <CarouselView IndicatorView="indicatorView" ItemsSource="{Binding Igrejas}">
            <CarouselView.ItemTemplate>
                <DataTemplate>
                    <StackLayout>
                        <Frame
                         Margin="20"
                         BorderColor="DarkGray"
                         CornerRadius="5"
                         HasShadow="True"
                         HeightRequest="450"
                         HorizontalOptions="Center"
                         VerticalOptions="CenterAndExpand">
                            <StackLayout>


                                <Image
                                 Aspect="AspectFill"
                                 HeightRequest="150"
                                 HorizontalOptions="Center"
                                 Source="{Binding ImgUrl}"
                                 WidthRequest="150" />
                                <Label
                                 FontAttributes="Bold"
                                 FontSize="18"
                                 HorizontalOptions="Center"
                                 Text="{Binding Nome}"
                                 VerticalOptions="Center" />
                                <Label HorizontalOptions="Center" Text="{Binding Fundacao}" />
                                <Label
                                 FontAttributes="Italic"
                                 HorizontalOptions="Center"
                                 LineBreakMode="TailTruncation"
                                 MaxLines="60"
                                 Text="{Binding Descricao}" />
                            </StackLayout>
                        </Frame>
                    </StackLayout>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>
        <IndicatorView
         x:Name="indicatorView"
         Grid.Row="1"
         HorizontalOptions="Center"
         IndicatorColor="Gainsboro"
         IndicatorSize="15"
         IndicatorsShape="Circle"
         SelectedIndicatorColor="#2196f3" />
    </VerticalStackLayout>
</ContentPage>